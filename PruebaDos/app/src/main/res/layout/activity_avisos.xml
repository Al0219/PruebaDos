<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etTituloAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título del aviso"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etContenidoAviso"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="Contenido"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etGrado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Grado (Ej: 5°)"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Sección (Ej: A)"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnPublicarAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publicar aviso" />
    </LinearLayout>
</ScrollView>
